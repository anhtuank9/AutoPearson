# Copy this file to .env. Never commit the resulting .env file.
# Fill in both credentials for automatic sign-in, or leave both empty and
# sign in manually in the browser window opened by the tool.
PEARSON_USERNAME=
PEARSON_PASSWORD=

# Optional. Active assignments are processed newest due date first.
PEARSON_START_URL=https://englishconnect.pearson.com/
PEARSON_MAX_ASSIGNMENTS=100
PEARSON_MAX_PAGES=300
PEARSON_CHECK_LIMIT=5
PEARSON_BROWSER=chrome
PEARSON_HEADLESS=0
PEARSON_ASSIGNMENT_FILTER=
PEARSON_LESSON_FILTER=
PEARSON_VIEWPORT_HEIGHT=900

# Set to 1 only while debugging. Trace files can contain lesson content.
PEARSON_TRACE_ANSWERS=0
